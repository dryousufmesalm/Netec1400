<Window x:Class="AmmarTrading.Sync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AmarTrading Sync"
        Width="1180"
        Height="800"
        MinWidth="880"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4F8FF">
    <Grid>
        <wv2:WebView2 x:Name="Browser" />
        <Grid x:Name="FatalPanel"
              Background="#F4F8FF"
              Visibility="Collapsed">
            <Border Width="560"
                    Padding="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    BorderBrush="#D9E3F0"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock x:Name="FatalTitle"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#172033"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="FatalMessage"
                               Margin="0,14,0,0"
                               FontSize="15"
                               LineHeight="23"
                               Foreground="#56637A"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
